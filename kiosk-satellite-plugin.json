{
  "schemaVersion": 1,
  "id": "ks-navbar-vista",
  "name": "Vista Navbar",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAndroidSdk": 26,
  "entryClass": "com.shymoose.ksnavbar.NavbarPlugin",
  "description": "A navigation bar for your dashboards, with a Windows Vista style and gesture actions.",
  "author": "dimatx",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "capabilities": [
    "overlay",
    "host.read",
    "host.control"
  ],
  "settings": [
    {
      "key": "style",
      "type": "select",
      "title": "Style",
      "default": "Kiosk",
      "group": "Appearance",
      "description": "Kiosk matches Kiosk Satellite. Windows Vista draws Aero glass and Vista icons.",
      "options": [
        "Kiosk",
        "Windows Vista"
      ]
    },
    {
      "key": "position",
      "type": "select",
      "title": "Position",
      "default": "Bottom",
      "group": "Appearance",
      "description": "The edge of the screen the bar sits on.",
      "options": [
        "Bottom",
        "Top",
        "Left",
        "Right"
      ]
    },
    {
      "key": "labels",
      "type": "select",
      "title": "Labels",
      "default": "Always",
      "group": "Appearance",
      "description": "When item names show under their icons.",
      "options": [
        "Always",
        "Active only",
        "Never"
      ]
    },
    {
      "key": "scale",
      "type": "select",
      "title": "Size",
      "default": "100%",
      "group": "Appearance",
      "description": "The size of the bar and its menus.",
      "options": [
        "80%",
        "90%",
        "100%",
        "110%",
        "120%",
        "140%"
      ]
    },
    {
      "key": "opacity",
      "type": "number",
      "title": "Opacity",
      "default": 100,
      "group": "Appearance",
      "description": "How much of the dashboard shows through.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "items",
      "type": "list",
      "title": "Items",
      "default": [
        {
          "label": "Home",
          "opens": "Page",
          "page": "lovelace/0",
          "icon": "mdi:home-outline",
          "iconSelected": "mdi:home",
          "vistaIcon": "Automatic"
        }
      ],
      "group": "Items",
      "addTitle": "Add item",
      "maxItems": 8,
      "row": {
        "title": "label",
        "subtitle": [
          "page",
          "action",
          "url",
          "trigger"
        ],
        "icon": "icon"
      },
      "fields": [
        {
          "key": "label",
          "type": "string",
          "title": "Label",
          "required": true
        },
        {
          "key": "opens",
          "type": "select",
          "title": "Opens",
          "options": [
            "Page",
            "Camera view",
            "Menu",
            "Kiosk action",
            "Web address",
            "Gesture action"
          ]
        },
        {
          "key": "page",
          "type": "dashboard",
          "title": "Page",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Page"
          }
        },
        {
          "key": "camera",
          "type": "cameraView",
          "title": "Camera view",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Camera view"
          }
        },
        {
          "key": "action",
          "type": "select",
          "title": "Action",
          "options": [
            "Music",
            "Now playing",
            "Screensaver",
            "App launcher",
            "Reload",
            "Start page"
          ],
          "visibleWhen": {
            "key": "opens",
            "equals": "Kiosk action"
          }
        },
        {
          "key": "url",
          "type": "string",
          "title": "Web address",
          "description": "An address starting with https://.",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Web address"
          }
        },
        {
          "key": "trigger",
          "type": "select",
          "title": "Gesture trigger",
          "description": "Map it under Gestures > Plugin trigger, for example to Start a voice command.",
          "options": [
            "Navbar button 1",
            "Navbar button 2",
            "Navbar button 3",
            "Navbar button 4",
            "Navbar button 5",
            "Navbar button 6",
            "Navbar button 7",
            "Navbar button 8"
          ],
          "visibleWhen": {
            "key": "opens",
            "equals": "Gesture action"
          }
        },
        {
          "key": "entries",
          "type": "list",
          "title": "Menu entries",
          "description": "Menus with more than 6 entries show as a grid.",
          "addTitle": "Add entry",
          "minItems": 1,
          "maxItems": 16,
          "visibleWhen": {
            "key": "opens",
            "equals": "Menu"
          },
          "row": {
            "title": "label",
            "subtitle": [
              "page",
              "action",
              "url",
              "trigger"
            ],
            "icon": "icon"
          },
          "fields": [
            {
              "key": "label",
              "type": "string",
              "title": "Label",
              "required": true
            },
            {
              "key": "opens",
              "type": "select",
              "title": "Opens",
              "options": [
                "Page",
                "Camera view",
                "Kiosk action",
                "Web address",
                "Gesture action"
              ]
            },
            {
              "key": "page",
              "type": "dashboard",
              "title": "Page",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Page"
              }
            },
            {
              "key": "camera",
              "type": "cameraView",
              "title": "Camera view",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Camera view"
              }
            },
            {
              "key": "action",
              "type": "select",
              "title": "Action",
              "options": [
                "Music",
                "Now playing",
                "Screensaver",
                "App launcher",
                "Reload",
                "Start page"
              ],
              "visibleWhen": {
                "key": "opens",
                "equals": "Kiosk action"
              }
            },
            {
              "key": "url",
              "type": "string",
              "title": "Web address",
              "description": "An address starting with https://.",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Web address"
              }
            },
            {
              "key": "trigger",
              "type": "select",
              "title": "Gesture trigger",
              "description": "Map it under Gestures > Plugin trigger, for example to Start a voice command.",
              "options": [
                "Navbar button 1",
                "Navbar button 2",
                "Navbar button 3",
                "Navbar button 4",
                "Navbar button 5",
                "Navbar button 6",
                "Navbar button 7",
                "Navbar button 8"
              ],
              "visibleWhen": {
                "key": "opens",
                "equals": "Gesture action"
              }
            },
            {
              "key": "icon",
              "type": "icon",
              "title": "Icon",
              "description": "Leave empty to have one picked from the label."
            },
            {
              "key": "vistaIcon",
              "type": "select",
              "title": "Vista icon",
              "description": "The picture in the Windows Vista style. Automatic matches it to the icon.",
              "options": [
                "Automatic",
                "Home",
                "Windows",
                "Computer",
                "Display",
                "Camera",
                "Camcorder",
                "Music",
                "Media player",
                "Pictures",
                "Calendar",
                "Clock",
                "Globe",
                "Network",
                "Shield",
                "Lock",
                "Settings",
                "People",
                "Search",
                "Microphone",
                "Speaker",
                "Phone",
                "Power",
                "Gauge",
                "Programs",
                "Folder",
                "Favorites",
                "Notes",
                "Mail",
                "Refresh",
                "Garden",
                "Games"
              ]
            }
          ]
        },
        {
          "key": "tapPage",
          "type": "dashboard",
          "title": "Tap opens",
          "description": "Optional. A tap opens this page and a long press opens the menu.",
          "visibleWhen": {
            "key": "opens",
            "equals": "Menu"
          }
        },
        {
          "key": "icon",
          "type": "icon",
          "title": "Icon",
          "description": "Leave empty to have one picked from the label."
        },
        {
          "key": "iconSelected",
          "type": "icon",
          "title": "Selected icon",
          "description": "The icon while this item's page is open. Uses Icon when empty."
        },
        {
          "key": "vistaIcon",
          "type": "select",
          "title": "Vista icon",
          "description": "The picture in the Windows Vista style. Automatic matches it to the icon.",
          "options": [
            "Automatic",
            "Home",
            "Windows",
            "Computer",
            "Display",
            "Camera",
            "Camcorder",
            "Music",
            "Media player",
            "Pictures",
            "Calendar",
            "Clock",
            "Globe",
            "Network",
            "Shield",
            "Lock",
            "Settings",
            "People",
            "Search",
            "Microphone",
            "Speaker",
            "Phone",
            "Power",
            "Gauge",
            "Programs",
            "Folder",
            "Favorites",
            "Notes",
            "Mail",
            "Refresh",
            "Garden",
            "Games"
          ]
        }
      ]
    },
    {
      "key": "collapse",
      "type": "select",
      "title": "Swipe to hide",
      "default": "Start visible",
      "group": "Behavior",
      "description": "Swipe the bar toward its edge to hide it behind a small tab.",
      "options": [
        "Start visible",
        "Start hidden",
        "Off"
      ]
    },
    {
      "key": "autoCollapse",
      "type": "number",
      "title": "Hide after",
      "default": 0,
      "group": "Behavior",
      "description": "How long the bar stays visible without a tap. 0 keeps it visible.",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "s",
      "visibleWhen": {
        "key": "collapse",
        "notEquals": "Off"
      }
    },
    {
      "key": "makeRoom",
      "type": "boolean",
      "title": "Keep the dashboard clear",
      "default": true,
      "group": "Behavior",
      "description": "End the dashboard above the bar instead of under it."
    },
    {
      "key": "overCameras",
      "type": "boolean",
      "title": "Show over camera views",
      "default": true,
      "group": "Behavior",
      "description": "Keep the bar on screen while a camera view is open, with a button to close it."
    },
    {
      "key": "hideOn",
      "type": "list",
      "title": "Pages",
      "default": [],
      "group": "Hide the bar on",
      "description": "The bar stays hidden on these pages.",
      "addTitle": "Add page",
      "maxItems": 32,
      "row": {
        "title": "page"
      },
      "fields": [
        {
          "key": "page",
          "type": "dashboard",
          "title": "Page",
          "required": true
        }
      ]
    }
  ],
  "commands": [
    {
      "id": "show",
      "title": "Show navbar"
    },
    {
      "id": "hide",
      "title": "Hide navbar"
    },
    {
      "id": "toggle",
      "title": "Toggle navbar"
    }
  ],
  "groups": [
    {
      "title": "Appearance"
    },
    {
      "title": "Items"
    },
    {
      "title": "Behavior"
    },
    {
      "title": "Hide the bar on"
    }
  ],
  "triggers": [
    {
      "id": "button1",
      "title": "Navbar button 1"
    },
    {
      "id": "button2",
      "title": "Navbar button 2"
    },
    {
      "id": "button3",
      "title": "Navbar button 3"
    },
    {
      "id": "button4",
      "title": "Navbar button 4"
    },
    {
      "id": "button5",
      "title": "Navbar button 5"
    },
    {
      "id": "button6",
      "title": "Navbar button 6"
    },
    {
      "id": "button7",
      "title": "Navbar button 7"
    },
    {
      "id": "button8",
      "title": "Navbar button 8"
    }
  ]
}
