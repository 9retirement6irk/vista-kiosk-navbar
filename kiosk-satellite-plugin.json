{
  "schemaVersion": 1,
  "id": "ks-navbar",
  "name": "Navbar",
  "version": "0.11.0",
  "apiVersion": 1,
  "minAndroidSdk": 26,
  "entryClass": "com.shymoose.ksnavbar.NavbarPlugin",
  "description": "A native navigation bar for your dashboards. It shows which page you're on and opens pages, menus and kiosk actions.",
  "author": "dimatx",
  "license": "Apache-2.0",
  "capabilities": [
    "overlay",
    "host.read",
    "host.control"
  ],
  "settings": [
    {
      "key": "position",
      "type": "select",
      "title": "Position",
      "default": "Bottom",
      "group": "Look",
      "description": "The screen edge the bar sits on.",
      "options": [
        "Bottom",
        "Top",
        "Left",
        "Right"
      ]
    },
    {
      "key": "labels",
      "type": "select",
      "title": "Labels",
      "default": "Always",
      "group": "Look",
      "description": "Text under the icons.",
      "options": [
        "Always",
        "Active only",
        "Never"
      ]
    },
    {
      "key": "scale",
      "type": "select",
      "title": "Size",
      "default": "100%",
      "group": "Look",
      "options": [
        "80%",
        "90%",
        "100%",
        "110%",
        "120%",
        "140%"
      ]
    },
    {
      "key": "opacity",
      "type": "number",
      "title": "Opacity",
      "default": 100,
      "group": "Look",
      "description": "Lower lets the dashboard show through.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "items",
      "type": "list",
      "title": "Items",
      "default": [
        {
          "label": "Home",
          "opens": "Page",
          "page": "lovelace/0",
          "icon": "mdi:home-outline",
          "iconSelected": "mdi:home"
        }
      ],
      "group": "Items",
      "addTitle": "Add item",
      "maxItems": 8,
      "row": {
        "title": "label",
        "subtitle": [
          "page",
          "action",
          "url"
        ],
        "icon": "icon"
      },
      "fields": [
        {
          "key": "label",
          "type": "string",
          "title": "Label",
          "required": true
        },
        {
          "key": "opens",
          "type": "select",
          "title": "Opens",
          "options": [
            "Page",
            "Camera view",
            "Menu",
            "Kiosk action",
            "Web address"
          ]
        },
        {
          "key": "page",
          "type": "dashboard",
          "title": "Page",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Page"
          }
        },
        {
          "key": "camera",
          "type": "cameraView",
          "title": "Camera view",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Camera view"
          }
        },
        {
          "key": "action",
          "type": "select",
          "title": "Action",
          "options": [
            "Music",
            "Now playing",
            "Screensaver",
            "App launcher",
            "Reload",
            "Start page"
          ],
          "visibleWhen": {
            "key": "opens",
            "equals": "Kiosk action"
          }
        },
        {
          "key": "url",
          "type": "string",
          "title": "Web address",
          "description": "Starts with https://",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Web address"
          }
        },
        {
          "key": "icon",
          "type": "icon",
          "title": "Icon",
          "description": "Picked from the label when empty."
        },
        {
          "key": "iconSelected",
          "type": "icon",
          "title": "Selected icon",
          "description": "Shown while this item's page is open. Optional."
        },
        {
          "key": "entries",
          "type": "list",
          "title": "Menu entries",
          "description": "More than 6 show as a grid.",
          "addTitle": "Add entry",
          "minItems": 1,
          "maxItems": 16,
          "visibleWhen": {
            "key": "opens",
            "equals": "Menu"
          },
          "row": {
            "title": "label",
            "subtitle": [
              "page",
              "action",
              "url"
            ],
            "icon": "icon"
          },
          "fields": [
            {
              "key": "label",
              "type": "string",
              "title": "Label",
              "required": true
            },
            {
              "key": "opens",
              "type": "select",
              "title": "Opens",
              "options": [
                "Page",
                "Camera view",
                "Kiosk action",
                "Web address"
              ]
            },
            {
              "key": "page",
              "type": "dashboard",
              "title": "Page",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Page"
              }
            },
            {
              "key": "camera",
              "type": "cameraView",
              "title": "Camera view",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Camera view"
              }
            },
            {
              "key": "action",
              "type": "select",
              "title": "Action",
              "options": [
                "Music",
                "Now playing",
                "Screensaver",
                "App launcher",
                "Reload",
                "Start page"
              ],
              "visibleWhen": {
                "key": "opens",
                "equals": "Kiosk action"
              }
            },
            {
              "key": "url",
              "type": "string",
              "title": "Web address",
              "description": "Starts with https://",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Web address"
              }
            },
            {
              "key": "icon",
              "type": "icon",
              "title": "Icon",
              "description": "Picked from the label when empty."
            }
          ]
        }
      ]
    },
    {
      "key": "collapse",
      "type": "select",
      "title": "Swipe to tuck away",
      "default": "Start open",
      "group": "Behavior",
      "description": "Swipe the bar toward the edge to tuck it into a small tab.",
      "options": [
        "Start open",
        "Start tucked away",
        "Off"
      ]
    },
    {
      "key": "autoCollapse",
      "type": "number",
      "title": "Tuck away after",
      "default": 0,
      "group": "Behavior",
      "description": "Without a tap. 0 keeps it open.",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "s",
      "visibleWhen": {
        "key": "collapse",
        "notEquals": "Off"
      }
    },
    {
      "key": "makeRoom",
      "type": "boolean",
      "title": "Keep the dashboard clear",
      "default": true,
      "group": "Behavior",
      "description": "The dashboard ends above the bar instead of under it."
    },
    {
      "key": "hideOn",
      "type": "string",
      "title": "Hide on",
      "default": "",
      "group": "Behavior",
      "description": "Pages without the bar, separated by commas, such as /profile."
    }
  ],
  "commands": [
    {
      "id": "show",
      "title": "Show navbar"
    },
    {
      "id": "hide",
      "title": "Hide navbar"
    },
    {
      "id": "toggle",
      "title": "Toggle navbar"
    }
  ],
  "groups": [
    {
      "title": "Look"
    },
    {
      "title": "Items"
    },
    {
      "title": "Behavior"
    }
  ]
}
